# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env.
# In production these values come from Secret Manager / environment variables.
# ---------------------------------------------------------------------------

# --- Application / Deployment ---
ENV=local
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (PostgreSQL, async driver) ---
DATABASE_URL=postgresql+asyncpg://user:password@host-pooler:5432/dbname?ssl=require
DIRECT_URL=postgresql+asyncpg://user:password@host:5432/dbname?ssl=require

# --- Agent Mode ---
# deterministic = rule-based assignment engine only (no LLM calls)
# llm           = Google ADK + Gemini agent on top of the same tools
AGENT_MODE=deterministic

# --- Google / Vertex AI (Phase 3) ---
GOOGLE_CLOUD_PROJECT=<YOUR_GOOGLE_CLOUD_PROJECT>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-2.5-flash

# --- Discord (Phase 4) ---
DISCORD_BOT_TOKEN=<YOUR_DISCORD_BOT_TOKEN>
DISCORD_APPLICATION_ID=<YOUR_DISCORD_APPLICATION_ID>
DISCORD_PUBLIC_KEY=<YOUR_DISCORD_PUBLIC_KEY>
DISCORD_GUILD_ID=<YOUR_DISCORD_GUILD_ID>

# --- Shared Internal API Token ---
INTERNAL_API_TOKEN=<YOUR_INTERNAL_API_TOKEN>

# --- Pinecone + Hybrid RAG (Phase 6) ---
PINECONE_API_KEY=<YOUR_PINECONE_API_KEY>
PINECONE_INDEX_NAME=<YOUR_PINECONE_INDEX_NAME>
PINECONE_ENVIRONMENT=<YOUR_PINECONE_ENVIRONMENT>
PINECONE_NAMESPACE_PREFIX=discord
RAG_VECTOR_STORE=pinecone
RAG_RETRIEVAL_MODE=hybrid
RAG_SEMANTIC_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
RAG_EMBEDDING_MODEL=text-embedding-004
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
