# ---------------------------------------------------------------------------
# Copy to .env for local development. NEVER commit a real .env.
# In production these values come from Google Cloud Secret Manager, injected
# into Cloud Run as environment variables (see docs/deployment.md).
# ---------------------------------------------------------------------------

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# --- Database (PostgreSQL, async driver) ---
# postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=

# --- Agent ---
# deterministic = rule-based assignment engine only (no LLM calls)
# llm           = Google ADK + Gemini agent on top of the same tools
AGENT_MODE=deterministic

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Optional: guild id used to register slash commands instantly during development
DISCORD_DEV_GUILD_ID=

# --- Bot -> Backend ---
BACKEND_BASE_URL=http://localhost:8000
# Shared secret the bot sends as X-Internal-Token; leave empty to disable the check
INTERNAL_API_TOKEN=

# --- Knowledge / RAG ---
# hashing = offline deterministic embeddings (dev/tests), vertex = Vertex AI embeddings
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=768
# memory = in-process store (dev/tests), postgres = chunks + vectors in PostgreSQL
VECTOR_STORE=postgres
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
